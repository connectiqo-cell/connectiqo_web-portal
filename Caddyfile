# ============================================
# Caddy Reverse Proxy Configuration
# Connectiqo Web Portal
# ============================================

# Primary domain and www redirect
app.connectiqo.com, www.app.connectiqo.com {
    # Redirect www to main domain
    @www host www.app.connectiqo.com
    redir @www https://app.connectiqo.com{uri} permanent

    # Enable gzip compression
    encode gzip

    # Reverse proxy to Next.js app (Docker container)
    reverse_proxy app:3000 {
        # Forward original request headers to backend
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Forwarded-Proto {http.request.proto}
        header_up X-Forwarded-Host {http.request.host}
        header_up X-Real-IP {http.request.remote.host}
        header_up Connection {http.request.header.Connection}
        header_up Upgrade {http.request.header.Upgrade}

        # WebSocket support
        websocket

        # Timeout settings (optimized for Next.js)
        transport http {
            read_timeout 60s
            write_timeout 60s
            dial_timeout 10s
            response_header_timeout 20s
        }
    }

    # ============================================
    # SECURITY HEADERS
    # ============================================
    header X-Frame-Options "SAMEORIGIN"
    header X-Content-Type-Options "nosniff"
    header X-XSS-Protection "1; mode=block"
    header Referrer-Policy "strict-origin-when-cross-origin"
    header Permissions-Policy "geolocation=(), microphone=(), camera=()"
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' *.supabase.co; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' *.supabase.co *.razorpay.com *.sentry.io;"

    # ============================================
    # CACHING POLICY
    # ============================================

    # Cache static assets (Next.js & public files)
    @static {
        path /_next/static/*
        path /public/*
        path *.js
        path *.css
        path *.png
        path *.jpg
        path *.gif
        path *.svg
        path *.ico
        path *.woff*
        path *.ttf
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
    header @static ETag "{http.response.header.ETag}"

    # Don't cache dynamic content
    @notStatic {
        not path /_next/static/*
        not path /public/*
    }
    header @notStatic Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    header @notStatic Pragma "no-cache"
    header @notStatic Expires "0"

    # ============================================
    # LOGGING
    # ============================================
    log {
        output stdout
        format json
        level info
    }
}

# ============================================
# HTTP REDIRECT TO HTTPS
# ============================================
http://app.connectiqo.com, http://www.app.connectiqo.com {
    redir https://app.connectiqo.com{uri} permanent
}

# ============================================
# NOTES
# ============================================
# - Automatic HTTPS certificate renewal (Let's Encrypt)
# - TLS is handled automatically by Caddy
# - All connections redirect to HTTPS
# - www subdomain redirects to main domain
# - WebSocket support for real-time features
# - Optimized for Next.js and Supabase integration
