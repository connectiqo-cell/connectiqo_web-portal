# Caddy reverse proxy configuration
# Update DOMAIN to your actual domain name when deploying

{DOMAIN} {
    # Encode gzip compression
    encode gzip

    # Reverse proxy to Next.js app
    reverse_proxy app:3000 {
        # Headers for Next.js
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Forwarded-Proto {http.request.proto}
        header_up X-Real-IP {http.request.remote.host}

        # Timeout settings
        transport http {
            read_timeout 60s
            write_timeout 60s
            dial_timeout 10s
            response_header_timeout 20s
        }
    }

    # Security headers
    header X-Frame-Options "SAMEORIGIN"
    header X-Content-Type-Options "nosniff"
    header X-XSS-Protection "1; mode=block"
    header Referrer-Policy "strict-origin-when-cross-origin"
    header Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Cache control for static assets
    @static {
        path /_next/static/*
        path /public/*
    }

    header @static Cache-Control "public, max-age=31536000, immutable"

    # Handle Next.js routes
    @notStatic {
        not path /_next/static/*
        not path /public/*
    }

    header @notStatic Cache-Control "no-cache, no-store, must-revalidate"

    # Automatic HTTPS and certificate renewal (handled by Caddy)
    # TLS handled automatically by Caddy
}

# HTTP redirect to HTTPS
http://{DOMAIN} {
    redir https://{DOMAIN}{uri} permanent
}
